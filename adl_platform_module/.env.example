# העתק לקובץ .env באותה תיקייה והזן ערכים אמיתיים (אל תעלה .env ל-git)

# כתובת API של ShareFlow (ייצור)
SHAREFLOW_API_URL=https://adlshareflow-production.up.railway.app/api

# אותו ערך כמו ADL_ADMIN_KEY ב-Railway → Variables
SHAREFLOW_ADMIN_KEY=

# סיסמת כניסה לממשק הניהול המקומי (לא קשור ל-Railway)
ADMIN_PASSWORD=

# אופציונלי
PORT=5002
SECRET_KEY=shareflow-admin-secret-change-me
